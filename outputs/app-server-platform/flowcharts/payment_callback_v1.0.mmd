flowchart TD
  A["App 发起平台支付"] --> B["Apple 或 Google 返回客户端结果"]
  B --> C["客户端可请求订单同步"]
  A --> D["平台发送支付通知到后端"]
  D --> E{"通知来源是否可识别"}
  E -- "否" --> E1["记录异常通知"]
  E -- "是" --> F["解析平台交易号和商品 ID"]
  F --> G{"事件是否已处理"}
  G -- "是" --> G1["返回幂等成功"]
  G -- "否" --> H["写入支付事件记录"]
  H --> I{"能否匹配订单"}
  I -- "否" --> I1["记录待排查事件"]
  I1 --> I2["后台订单页展示异常"]
  I -- "是" --> J["更新订单状态"]
  J --> K{"状态是否支付成功"}
  K -- "否" --> K1["记录失败或取消状态"]
  K -- "是" --> L["记录支付成功时间"]
  L --> M["后台订单页展示已支付"]
  K1 --> N["后台订单页展示最新状态"]
