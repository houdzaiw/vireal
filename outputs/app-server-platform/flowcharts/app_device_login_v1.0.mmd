flowchart TD
  A["App 启动"] --> B["读取本机设备 UUID"]
  B --> C{"设备 UUID 是否存在"}
  C -- "不存在" --> C1["生成本机设备 UUID"]
  C -- "存在" --> D["请求设备号登录接口"]
  C1 --> D
  D --> E{"网络是否正常"}
  E -- "否" --> E1["展示网络异常提示"]
  E1 --> E2["保留本地默认配置"]
  E -- "是" --> F["服务端校验设备 UUID"]
  F --> G{"设备是否已绑定 App 用户"}
  G -- "否" --> H["创建 App 用户"]
  H --> I["创建设备绑定记录"]
  G -- "是" --> J["更新最近登录时间"]
  I --> K["签发长期 App token"]
  J --> K
  K --> L["返回用户资料和 token"]
  L --> M["App 拉取启动配置"]
  M --> N{"配置接口是否成功"}
  N -- "否" --> N1["使用本地默认配置"]
  N -- "是" --> O["缓存启用配置"]
  O --> P["进入动态流"]
  N1 --> P
