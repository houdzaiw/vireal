flowchart TD
  A["管理员进入运营配置页"] --> B["新增或编辑 key value 配置"]
  B --> C{"key 是否唯一"}
  C -- "否" --> C1["提示 key 已存在"]
  C -- "是" --> D["保存配置值和说明"]
  D --> E{"是否启用配置"}
  E -- "否" --> F["配置不对 App 下发"]
  E -- "是" --> G["配置进入启用集合"]
  G --> H["App 启动后请求配置接口"]
  F --> H
  H --> I{"配置接口是否成功"}
  I -- "否" --> I1["App 使用默认配置"]
  I -- "是" --> J["服务端读取启用配置"]
  J --> K["返回 key value 对象"]
  K --> L["App 缓存配置并应用"]
  A --> M["管理员停用配置"]
  M --> N["更新启用状态为关闭"]
  N --> O["下次启动不再返回该 key"]
