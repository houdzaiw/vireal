flowchart TD
  A["管理员打开后台"] --> B["输入账号密码"]
  B --> C{"账号密码是否正确"}
  C -- "否" --> C1["展示登录失败"]
  C -- "是" --> D["进入后台管理"]
  D --> E["查看 App 用户列表"]
  D --> F["查看动态内容列表"]
  E --> G{"选择用户操作"}
  G -- "禁用用户" --> H["弹出禁用确认"]
  H --> I{"是否确认"}
  I -- "否" --> E
  I -- "是" --> J["更新用户状态为禁用"]
  J --> K["App 发布接口拒绝该用户"]
  J --> L["App 动态流过滤该用户内容"]
  G -- "删除用户" --> M["弹出删除确认"]
  M --> N{"是否确认"}
  N -- "否" --> E
  N -- "是" --> O["写入用户删除时间"]
  O --> P["后台默认列表移除用户"]
  F --> Q{"选择内容操作"}
  Q -- "删除动态" --> R["弹出删除确认"]
  R --> S{"是否确认"}
  S -- "否" --> F
  S -- "是" --> T["写入动态删除时间"]
  T --> U["App 列表和详情不再返回"]
