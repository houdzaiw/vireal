flowchart TD
  A["用户进入发布页"] --> B["输入文字并选择图片"]
  B --> C{"内容是否为空"}
  C -- "是" --> C1["提示需要文字或图片"]
  C -- "否" --> D{"图片是否符合限制"}
  D -- "否" --> D1["提示图片类型或大小错误"]
  D -- "是" --> E{"网络是否正常"}
  E -- "否" --> E1["提示网络异常并保留草稿"]
  E -- "是" --> F["上传图片到本地文件存储"]
  F --> G{"上传是否成功"}
  G -- "否" --> G1["提示上传失败"]
  G1 --> B
  G -- "是" --> H["提交动态发布接口"]
  H --> I{"用户状态是否正常"}
  I -- "否" --> I1["提示账号已禁用"]
  I -- "是" --> J["创建动态和图片记录"]
  J --> K["返回发布成功"]
  K --> L["动态流插入新内容"]
  L --> M["App 请求动态列表"]
  M --> N["服务端过滤已删除内容"]
  N --> O["过滤禁用用户内容"]
  O --> P["返回可展示动态"]
