FASTAPI_ENV=development

PROJECT_NAME="App Server Platform"
FRONTEND_HOST=http://localhost:5173
# JSON array of additional H5 origins allowed to call the API.
BACKEND_CORS_ORIGINS=[]
APP_AUTH_MODE=device
# In dual/clerk mode the regular Clerk session token must include
# the custom claim {"aud":"vireal-api"}.
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=[]
ADMIN_PUBLIC_SIGNUP_ENABLED=false
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_SECONDS=900
CLOUDFLARE_ACCESS_REQUIRED=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
PUBLIC_API_DOCS_ENABLED=false

SECRET_KEY=replace-with-a-long-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-secure-password

EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Uploads
# Use "r2" in production after filling all R2_* values below.
APP_IMAGE_STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_IMAGE_BYTES=5242880
MAX_CATALOG_IMAGE_BYTES=10485760
MAX_CATALOG_VIDEO_BYTES=104857600
# Cloudflare Dashboard > R2 > Overview. The endpoint format is:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=vireal-media-prod
R2_OBJECT_PREFIX=vireal
R2_DOWNLOAD_URL_EXPIRE_SECONDS=300
R2_REPLICATE_URL_EXPIRE_SECONDS=3600
R2_VIDEO_PLAYBACK_URL_EXPIRE_SECONDS=300
APP_MEDIA_RETENTION_HOURS=24
MAX_GENERATED_VIDEO_BYTES=262144000
VIDEO_WORKER_POLL_SECONDS=2
VIDEO_WORKER_MAX_ATTEMPTS=5
VIDEO_CLEANUP_INTERVAL_SECONDS=60
APP_USER_DAILY_REAL_SUBMISSIONS=5
APP_USER_MAX_CONCURRENT_VIDEO_TASKS=1
APP_WAN_DAILY_GLOBAL_SUBMISSIONS=30
APP_GLOBAL_DAILY_REAL_SUBMISSIONS=30
APP_PUBLIC_REGISTRATION_ENABLED=False
APP_CONTROLLED_REGISTRATION_ENABLED=False
APP_CONTROLLED_REGISTRATION_EMAIL=
# Optional, separately approved mainland setup window; no commerce, at most 8h.
APP_CONTROLLED_CN_ACCOUNT_SETUP_ENABLED=False
APP_CONTROLLED_CN_ACCOUNT_SETUP_EXPIRES_AT=
# Default-off, existing exact Clerk subject only. Never enables payment/signup.
APP_INTERNAL_ACCEPTANCE_ENABLED=False
APP_INTERNAL_ACCEPTANCE_SUBJECT=
APP_LIVE_ACCEPTANCE_ENABLED=False
APP_LIVE_ACCEPTANCE_SUBJECTS=[]
# Local implementation only; activation requires separate review/approval.
# One existing account / one USD 5.99 order, no signup/upload/generation.
# Reviewed verified primary email: li522903183@163.com. IDs require rechecking;
# never reuse the previous beneficiary's IDs or migrate its order/ledger.
# Signed CN/HK only; adding HK never renews the explicit existing deadline.
APP_PAYMENT_ONLY_ACCEPTANCE_ENABLED=False
APP_PAYMENT_ONLY_ACCEPTANCE_SUBJECT=
APP_PAYMENT_ONLY_ACCEPTANCE_USER_ID=
APP_PAYMENT_ONLY_ACCEPTANCE_EXPIRES_AT=
# Production-only visibility/submission gate; does not delete unpublished effects.
APP_LAUNCH_EFFECT_SLUGS=["dance-1","romance-1"]
APP_VIDEO_SUBMISSIONS_ENABLED=True
APP_COMMERCE_TERMS_APPROVED=False
APP_REGION_ENFORCEMENT_ENABLED=False
# APP_EDGE_SIGNING_SECRET=<32+ random characters; same secret as the edge Worker>
PAYPAL_ENABLED=False
PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CLIENT_ID=<sandbox client ID; use live only in production>
# PAYPAL_CLIENT_SECRET=<configure as a secret, never commit>
# PAYPAL_MERCHANT_ID=<verified receiving merchant ID>
# PAYPAL_WEBHOOK_ID=<this environment's registered webhook ID>
PAYPAL_RECONCILE_INTERVAL_SECONDS=60
APP_SUPPORT_EMAIL=li522903183@gmail.com
# Public catalogue and new effect tasks only; existing tasks/config stay intact.
# Set to 15 only after the longer-duration provider has passed acceptance.
APP_EFFECT_MAX_DURATION_SECONDS=10
APP_LEGACY_VIDEO_TASKS_ENABLED=True
LOCAL_DEMO_ENABLED=True
LOCAL_DEMO_FFMPEG_PATH=/usr/bin/ffmpeg
LOCAL_DEMO_TIMEOUT_SECONDS=180

# Replicate video generation. Keep disabled until a server-side token and
# provider-readable HTTPS asset URLs are configured.
REPLICATE_ENABLED=False
# REPLICATE_API_TOKEN=r8_your-replicate-token
REPLICATE_STANDARD_MODEL=minimax/video-01
REPLICATE_ADVANCED_MODEL=wan-video/wan-2.7-r2v
REPLICATE_R2V_MODEL=wan-video/wan-2.7-r2v
# Use bytedance/seedance-2.0 only after the multi-person/15s PoC is accepted.
# REPLICATE_R2V_MODEL=bytedance/seedance-2.0
REPLICATE_ANIMATE_MODEL=wan-video/wan-2.2-animate-animation
# REPLICATE_WEBHOOK_URL=https://api.usevireal.com/api/v1/webhooks/replicate
# REPLICATE_WEBHOOK_SIGNING_SECRET=whsec_your-signing-secret
REPLICATE_REQUEST_TIMEOUT_SECONDS=30
REPLICATE_WEBHOOK_TOLERANCE_SECONDS=300
# Optional lifetime safety ceiling. Zero disables it; daily limits still apply.
REPLICATE_POC_MAX_SUBMISSIONS=0

# AI generation
APP_GENERATION_PROVIDER=local
APP_GENERATION_LOCAL_DELAY_SECONDS=1.5
APP_PUBLIC_BASE_URL=
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_SEEDANCE_MODEL=doubao-seedance-2-0-260128
ARK_SEEDREAM_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_RESOLUTION=720p
ARK_VIDEO_POLL_INTERVAL_SECONDS=5
ARK_VIDEO_POLL_TIMEOUT_SECONDS=600

# Payment callbacks
PAYMENT_WEBHOOK_VERIFICATION_MODE=local
# PAYMENT_WEBHOOK_VERIFICATION_MODE=shared_secret
# PAYMENT_WEBHOOK_SHARED_SECRET=replace-with-a-long-random-secret

# Postgres
POSTGRES_PASSWORD=replace-with-a-secure-password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
