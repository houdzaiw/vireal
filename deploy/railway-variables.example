# Copy these variables into both vireal-api and vireal-video-worker.
# Keep FASTAPI_ENV unset in production so default-secret checks stay enabled.

PROJECT_NAME=Vireal
FRONTEND_HOST=https://app.usevireal.com
BACKEND_CORS_ORIGINS=["https://app.usevireal.com","https://admin.usevireal.com"]

# Clerk production authentication. Use dual only during the backend-first rollout;
# switch to clerk before the production H5 is released.
# Configure the regular Clerk session token with {"aud":"vireal-api"}.
APP_AUTH_MODE=clerk
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=vireal-api
CLERK_SECRET_KEY=sk_live_replace-with-clerk-secret
CLERK_AUTHORIZED_PARTIES=["https://app.usevireal.com"]

# The admin UI is served by this same Railway service at admin.usevireal.com.
# Cloudflare Access adds its signed assertion before the request reaches FastAPI.
CLOUDFLARE_ACCESS_REQUIRED=true
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-access-application-audience
ADMIN_PUBLIC_SIGNUP_ENABLED=false
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_SECONDS=900
PUBLIC_API_DOCS_ENABLED=false

SECRET_KEY=replace-with-a-long-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-secure-password

# Use the direct Neon PostgreSQL connection string for the PoC.
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

APP_IMAGE_STORAGE_BACKEND=r2
MAX_UPLOAD_IMAGE_BYTES=5242880
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=vireal-media-prod
R2_OBJECT_PREFIX=vireal
R2_DOWNLOAD_URL_EXPIRE_SECONDS=300
R2_REPLICATE_URL_EXPIRE_SECONDS=3600
R2_VIDEO_PLAYBACK_URL_EXPIRE_SECONDS=300
APP_MEDIA_RETENTION_HOURS=24
MAX_GENERATED_VIDEO_BYTES=262144000
VIDEO_WORKER_POLL_SECONDS=2
VIDEO_WORKER_MAX_ATTEMPTS=5
VIDEO_CLEANUP_INTERVAL_SECONDS=60
APP_USER_DAILY_REAL_SUBMISSIONS=5
APP_WAN_DAILY_GLOBAL_SUBMISSIONS=3
LOCAL_DEMO_ENABLED=True
LOCAL_DEMO_FFMPEG_PATH=/usr/bin/ffmpeg
LOCAL_DEMO_TIMEOUT_SECONDS=180

# Deploy with false first. Change to true only after the HTTPS webhook check passes.
REPLICATE_ENABLED=False
REPLICATE_API_TOKEN=replace-with-replicate-token
REPLICATE_STANDARD_MODEL=minimax/video-01
REPLICATE_ADVANCED_MODEL=wan-video/wan-2.7-r2v
REPLICATE_R2V_MODEL=wan-video/wan-2.7-r2v
REPLICATE_WEBHOOK_URL=https://api.usevireal.com/api/v1/webhooks/replicate
REPLICATE_WEBHOOK_SIGNING_SECRET=whsec_replace-with-signing-secret
REPLICATE_REQUEST_TIMEOUT_SECONDS=30
REPLICATE_WEBHOOK_TOLERANCE_SECONDS=300
REPLICATE_POC_MAX_SUBMISSIONS=0

# Keep the existing /app/generations API available without sending work to Ark.
# The Replicate PoC uses /app/video-tasks and is controlled separately above.
APP_GENERATION_PROVIDER=local
APP_GENERATION_LOCAL_DELAY_SECONDS=1.5
APP_PUBLIC_BASE_URL=https://api.usevireal.com
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_SEEDANCE_MODEL=doubao-seedance-2-0-260128
ARK_SEEDREAM_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_RESOLUTION=720p
ARK_VIDEO_POLL_INTERVAL_SECONDS=5
ARK_VIDEO_POLL_TIMEOUT_SECONDS=600

# Optional email and monitoring configuration.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SENTRY_DSN=
